# Environment template for the weekly class scheduler.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is ignored by Git. NEVER commit real secrets.
#
# For LOCAL development you normally do not need `.env` at all: the dev
# Docker override (docker-compose.override.yml) forces DJANGO_DEBUG=1 and
# publishes port 8000. If you do copy this file for local use, the override
# still wins, so DEBUG stays on locally.
#
# The values below are the PRODUCTION template (DEBUG off, real domain).

# --- Django ---------------------------------------------------------------
# Required in production (the app refuses to start without it when DEBUG=False).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=scheduler.hesabinoo.ir
# Comma-separated origins allowed for unsafe (POST) requests over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://scheduler.hesabinoo.ir
DJANGO_TIME_ZONE=Asia/Tehran

# --- PostgreSQL -----------------------------------------------------------
# Keep PostgreSQL private; it is not published to the host.
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- HTTPS hardening (optional overrides) ---------------------------------
# These already default safely in production (DEBUG=False): secure cookies,
# HSTS for one year and HSTS include-subdomains. Only set them here to change
# the defaults. SECURE_SSL_REDIRECT is off by default so a misconfigured proxy
# cannot create a redirect loop; enable it once the proxy is confirmed to send
# X-Forwarded-Proto: https.
#
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
# DJANGO_SECURE_REFERRER_POLICY=same-origin
# DJANGO_X_FRAME_OPTIONS=DENY

# --- Gunicorn (production compose) ----------------------------------------
# Conservative by default for a 1 vCPU / ~2 GB VPS with no swap.
# GUNICORN_WORKERS=1
# GUNICORN_TIMEOUT=30
